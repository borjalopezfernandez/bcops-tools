#!/usr/bin/env python

import os
import shutil
import pathlib
from datetime import datetime, timedelta
from zoneinfo import ZoneInfo

try:
    import eocfi
except Exception as e:
    print(f'Error importing eocfi: {e}')
    print(f'Please install eocfi:') 
    print('https://eop-cfi.esa.int/index.php/mission-cfi-software/eocfi-software')
    exit(1)

from eocfi.api_xd import xd_read_fhr

from loguru import logger
logger = logger.patch(lambda record: record.update(name=record["file"].name))

from importlib.metadata import version as package_version

# ===========================================================================================================================================================================
# patching configuration according to the redmine issues:
# 
def _init_patching_dates():
    list_patching_dates = []
    patching_element    = {}
    
    patching_element['station_id']      = 'IVK_____'
    patching_element['relative_orbit']  = 38
    patching_element['date_start']      = datetime.strptime('UTC=2026-03-12T00:00:00+0000', 'UTC=%Y-%m-%dT%H:%M:%S%z')
    # Plus 7 RC
    patching_element['date_end']        = patching_element['date_start'] + timedelta(days = 21)
    logger.info(f'Patching config: {patching_element['date_start']} to {patching_element['date_end']} station {patching_element["station_id"]} and relative orbit {patching_element["relative_orbit"]}')
    list_patching_dates.append(patching_element)
    
    patching_element = patching_element.copy()
    patching_element['station_id']      = 'KSE_____'
    patching_element['relative_orbit']  = 12
    patching_element['date_start']      = datetime.strptime('UTC=2026-03-02T00:00:00+0000', 'UTC=%Y-%m-%dT%H:%M:%S%z')
    # Plus 7 RC
    patching_element['date_end']        = patching_element['date_start'] + timedelta(days = 21)
    logger.info(f'Patching config: {patching_element['date_start']} to {patching_element['date_end']} station {patching_element["station_id"]} and relative orbit {patching_element["relative_orbit"]}')
    list_patching_dates.append(patching_element)

    return list_patching_dates

import click
CONTEXT_SETTINGS = {"help_option_names": ['-h', '--help'], "max_content_width" : 220}

@click.command(context_settings=CONTEXT_SETTINGS, no_args_is_help = True)
@click.option('--file', '-f',                                            help = 'file MPL_PPF_1_ to be patched')
@click.option('--version', '-v',     is_flag = True, default = False,    help = 'It shows the version')
@click.option('--Silent', '-S',      is_flag = True, default = False,    help = 'Avoid logging messages')
@click.option('--Debug', '-D',       is_flag = True, default = False,    help = 'Debug flag for verbose messages')

def patch_ppf_idle_frames(file: str, version: bool, silent: bool, debug: bool):

    """
    \b
    First update to address
    https://redmineng.exprivia.it/issues/6603
    CW#18 2026
    > Inuvik relative orbit #38
    > Kiruna relative orbit #17
    
    Patch the BMPF MPL_PPF_1 for idle frames transmission according to:
    https://redmineng.exprivia.it/issues/5336
    > Inuvik relative orbit #38
    > Inuvik relative orbit #33
    > Kiruna relative orbit #12
    > Kiruna relative orbit #17
    \b
    """

    if version == True:
        print(f"{os.path.basename(__file__)} - {package_version('bcops')}")
        exit(0)

    if pathlib.Path(f'/data/mpf/BMPF/data/outgoing/MPL_PPF___/{file}').exists() == False:
        logger.error(f'file /data/mpf/BMPF/data/outgoing/MPL_PPF___/{file} not found')
        exit(1)

    if pathlib.Path(f'/data/mpf/BMPF/{file}_PATCHED').exists() == True:
        logger.info(f'It seems {file} has been previously patched')
        logger.error(f'file /data/mpf/BMPF/{file}_PATCHED already exists')
        exit(1)

    if pathlib.Path(f'/data/mpf/BMPF/{file}_ORIGINAL').exists() == True:
        logger.info(f'It seems {file} has been previously patched')
        logger.error(f'file /data/mpf/BMPF/{file}_ORIGINAL already exists')
        exit(1)

    logger.info(f'copy file /data/mpf/BMPF/data/outgoing/MPL_PPF___/{file} to /data/mpf/BMPF/{file}_ORIGINAL')
    shutil.copyfile(f'/data/mpf/BMPF/data/outgoing/MPL_PPF___/{file}', f'/data/mpf/BMPF/{file}_ORIGINAL')

    logger.info(f'copy file /data/mpf/BMPF/data/outgoing/MPL_PPF___/{file} to /data/mpf/BMPF/{file}')
    shutil.copyfile(f'/data/mpf/BMPF/data/outgoing/MPL_PPF___/{file}', f'/data/mpf/BMPF/{file}')

    logger.info(f'patching file /data/mpf/BMPF/{file}')

    fhr = xd_read_fhr(f'/data/mpf/BMPF/{file}')
    val_str_start       = fhr['val_start_date']
    val_str_end         = fhr['val_stop_date']
    val_datetime_start  = datetime.strptime(val_str_start, 'UTC=%Y-%m-%dT%H:%M:%S').replace(tzinfo = ZoneInfo('UTC'))
    val_datetime_end    = datetime.strptime(val_str_end, 'UTC=%Y-%m-%dT%H:%M:%S').replace(tzinfo = ZoneInfo('UTC'))
    list_patching_dates = _init_patching_dates()
    original_file       = file
    
    for patching_date in list_patching_dates:
        if patching_date['date_start'] <= val_datetime_start and patching_date['date_end'] >= val_datetime_start \
            or patching_date['date_start'] <= val_datetime_end and patching_date['date_end'] >= val_datetime_end:
            cmd = f'bcops_bmpf_downlink_idleframes -s {patching_date['date_start'].strftime('%Y-%m-%dT%H:%M:%S')} -e {patching_date['date_end'].strftime('%Y-%m-%dT%H:%M:%S')} --station-id {patching_date["station_id"]} -o {patching_date["relative_orbit"]} -f /data/mpf/BMPF/{file}'
            logger.info(cmd)
            ret = os.system(cmd)
            if ret != 0:
                logger.error(f'Error running command: {cmd}')
                exit(1)
            file = f'{file}_patched'

    logger.info(f'copy file /data/mpf/BMPF/{file} to /data/mpf/BMPF/{original_file}_PATCHED')
    shutil.copyfile(f'/data/mpf/BMPF/{file}', f'/data/mpf/BMPF/{original_file}_PATCHED')

    logger.info(f'replace file to be sent /data/mpf/BMPF/data/outgoing/MPL_PPF___/{original_file} with patched file /data/mpf/BMPF/{original_file}_PATCHED')
    shutil.copyfile(f'/data/mpf/BMPF/{original_file}_PATCHED', f'/data/mpf/BMPF/data/outgoing/MPL_PPF___/{original_file}')

    exit(0)

# ===========================================================================================================================================================================



def version():
    return package_version('bcops')

if __name__ == '__main__':
    patch_ppf_idle_frames()


exit(0)