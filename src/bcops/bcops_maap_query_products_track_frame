#!/usr/bin/env python

from pystac_client import Client
from datetime import datetime, timezone
import pytz
import csv as csv_file

from loguru import logger
logger = logger.patch(lambda record: record.update(name=record["file"].name))

import click
CONTEXT_SETTINGS = {"help_option_names": ['-h', '--help'], "max_content_width" : 220}

@click.command(context_settings=CONTEXT_SETTINGS, no_args_is_help = True)
@click.option('--Track', '-T',                                           help = 'Track number')
@click.option('--Frame', '-F',                                           help = 'Frame number')
@click.option('--type', '-t',                                            help = 'API productType filter FP_FH__L2A | FP_GN__L2A | FP_FD__L2A')
@click.option('--baseline', '-b',                                        help = 'API product version attribute matching the baseline (e.g. 02)')
@click.option('--CSV', '-C',         is_flag = True, default = False,    help = 'Output results to CSV file')
@click.option('--version', '-v',     is_flag = True, default = False,    help = 'It shows the version')
@click.option('--Silent', '-S',      is_flag = True, default = False,    help = 'Avoid logging messages')
@click.option('--Debug', '-D',       is_flag = True, default = False,    help = 'Debug flag for verbose messages')

def query_products(track: str, frame: str, type: str, baseline: str, csv: bool, version: bool, silent: bool, debug: bool):

    """
    \b
    Query MAAP catalogue for BIOMASS products by track and frame

    S2_SCS__1S

    
    \b

    """

    URL_LANDING_PAGE =  'https://catalog.maap.eo.esa.int/catalogue/'
    api = Client.open(URL_LANDING_PAGE) 

   
    datetime_tom_phase  = datetime(2025, 11, 21, 0, 29, 45, tzinfo = pytz.utc)
    bio_collections     = None

    if type[-7:] == 'RAW__0S':
        bio_collections = ['BiomassLevel0IOC', 'BiomassLevel0']

    if type[-7:] == 'SCS__1S':
        bio_collections = ['BiomassLevel1aIOC', 'BiomassLevel1a']

    if type[-7:] == 'DGM__1S':
        bio_collections = ['BiomassLevel1bIOC', 'BiomassLevel1b']

    if type[-7:] == 'STA__1S':
        bio_collections = ['BiomassLevel1cIOC', 'BiomassLevel1c']

    if type == 'FP_GN__L2A':
        bio_collections = ['BiomassLevel2aIOC', 'BiomassLevel2a']

    if type == 'FP_FD__L2A':
        bio_collections = ['BiomassLevel2aIOC', 'BiomassLevel2a']

    if type == 'FP_FH__L2A':
        bio_collections = ['BiomassLevel2aIOC', 'BiomassLevel2a']
    
    if type[-7:] == '_ERP_RD':
        bio_collections = ['BiomassAuxRestIOC', 'BiomassAuxRest']

    if type[-7:] == '_TEC___':
        bio_collections = ['BiomassAuxRestIOC', 'BiomassAuxRest']

    if bio_collections is None:
        logger.error(f"Error: product type {type} {type[-7:]} is not supported")
        exit(1)
    
    datetime_now        = datetime.now(pytz.utc)
    
    if baseline == None:
        filename            = f'bcops_maap_query_datatake_{type}_BXX_C{datetime_now.strftime("%Y%m%dT%H%M%S")}.csv'
    else:
        filename            = f'bcops_maap_query_datatake_{type}_B{baseline}_C{datetime_now.strftime("%Y%m%dT%H%M%S")}.csv'

    api = None
    try:
        api  = Client.open(URL_LANDING_PAGE)
    except Exception as e:
        logger.error(f"Error when connecting to {URL_LANDING_PAGE}")
        logger.error(f"{e}")
        exit(1)
    
    if baseline is not None:
        if debug == True:
            logger.debug(f"api.search GET limit = 500 ; collection = {bio_collections} ; filter = productType='{type}' and version='{baseline}' and track='{track}' and frame='{frame}'")
        results = api.search(
            method      = 'GET',
            limit       = 500,
            collections = bio_collections,
            filter      = f"productType='{type}' and track='{track}' and frame='{frame}' and version='{baseline}'"
        )
    else:
        if debug == True:
            logger.debug(f"api.search GET limit = 500 ; collection = {bio_collections} ; filter = productType='{type}' ; track='{track}' and frame='{frame}'")
        results = api.search(
            method      =   'GET',
            limit       =   500,
            collections =   bio_collections,
            filter      =   f"(productType='{type}' and track='{track}' and frame='{frame}')"
        )

    num_matched = results.matched()

    if debug == True:
        logger.debug(f"{num_matched} items found")

    if not silent:
        for item in results.items():
            print(item.to_dict()['id'])

    exit(0)


    records=[]

    counter_items = 0

    try:
        for i, it in enumerate(results.items(), 1):
            counter_items = i
            if not silent:
                print(f"\r{i}", end=' ', flush = True)
            d = it.to_dict()

            flat = {
                'product_id'        : d.get("id"),
                'platform'          : d['properties'].get("platform"),
                'start_datetime'    : d['properties'].get("start_datetime"),
                'end_datetime'      : d['properties'].get("end_datetime"),
                'product_type'      : d['properties'].get("product:type"),
                'global_coverage'   : d['properties'].get("eofeos:global_coverage_id"),
                'major_cycle'       : d['properties'].get("eofeos:major_cycle_id"),
                'phase'             : d['properties'].get("eofeos:mission_phase"),
                'drift_flag'        : d['properties'].get("eofeos:orbit_drift_flag"),
                'repeat_cycle'      : d['properties'].get("eofeos:repeat_cycle_id"),
                'datatake_id'       : d['properties'].get("eopf:datatake_id"),
            }
            records.append(flat)
    except Exception as e:
        logger.error(f"Error querying maap at item retrieval {counter_items}/{num_matched}")
        logger.error(e)
        exit(99)

    list_sorted         = sorted(records, key=lambda x: x['product_id'])

    file_handler        = open(filename, mode = 'w', newline = '')  
    csv_writer          = csv_file.writer(file_handler, delimiter = ',')
    header              = ['datatake_id', 'product_type', 'product_id', 'sensing_start', 'sensing_end']
    csv_writer.writerow(header)

    prev_datatake = None
    if not silent:
        print()

    for i, item in enumerate(list_sorted, 1):
        row = [
                item['datatake_id'],
                item['product_type'],
                item['product_id'],
                item['start_datetime'],
                item['end_datetime']
            ]
        csv_writer.writerow(row)
        if item['datatake_id'] != prev_datatake:
            prev_datatake = item['datatake_id']
            print(f"{item['datatake_id']}")


if __name__ == '__main__':
    query_products()

exit(0)