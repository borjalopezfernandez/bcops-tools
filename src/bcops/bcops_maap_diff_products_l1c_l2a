def parse_products_l1c_l2a(input_l1c: str, input_l2a: str, csv: bool, version: bool, silent: bool, debug: bool):

    """
    \b
    Query MAAP catalogue export for BIOMASS L1C products grouping them by Track number & Frame number:
    Example of 7 RC below:
    T_G01_M03_[C01,C02,C03,C04,C05,C06,C07]_T005_F012_02
    
    CSV file naming convention is:
        bcops_maap_query_datatake_<product_type>_<start_datetime>_<end_datetime>_C<current_datetime>.csv

    CSV file format is:
        datatake_id, product_type, product_id, sensing_start, sensing_end

    \b

    """

    input_path_l1C  = input_l1c
    input_path_l2A  = input_l2a
    p           = Path(input_path_l1C)
    output_path = str(p.with_name(p.stem + "_grouped.csv"))
    
    if debug == True:
        logger.debug(f"Loading L1C input file: {input_path_l1C}")

    groups_l1C, unmatched_l1C, fieldnames_l1C = load_and_group(input_path_l1C)
    
    p           = Path(input_path_l1C)
    output_path = str(p.with_name(p.stem + "_grouped.csv"))
        
    if debug == True:
        logger.debug(f"Loading L2A input file: {input_path_l2A}")
    
    groups_l2A, unmatched_l2A, fieldnames_l2A = load_and_group(input_path_l2A)
    # print_summary(groups_l2A)

    diff_groups(groups_l1C, groups_l2A)

    

if __name__ == '__main__':
    parse_products_l1c_l2a()

